<script>
  const response = await fetch(
    "https://api.github.com/repos/teknikfokus/teknikfokus.github.io/contents/data.json?ref=spotdata",
    {
      headers: {
        Accept: "application/vnd.github.v3.raw",
      },
    }
  );
  const responseData = await response.json();
  console.log(responseData);
  responseData.day2.forEach((spot: { id: string; occupied: any }) => {
    const spotId = "day2-spot-" + spot.id;
    var elem = document.getElementById(spotId);
    if (elem !== null) {
      elem.style.fill = spot.occupied ? "#ef403d" : "#5eb668";
    }
  });
</script>

