---
import Availabilitymapday1 from "~/components/availabilitymapday1.astro";
import Availabilitymapday2 from "~/components/availabilitymapday2.astro";

import Layout from "~/layouts/Layout.astro";
---

<Layout>
  <div class="mx-auto max-w-prose px-8 pt-10">
    <section>
      <h2
        class="bg-gradient-to-br from-blue-600 to-cyan-400 bg-clip-text font-extrabold tracking-tight text-transparent text-6xl"
      >
        Secure your spot!
      </h2>
      Here you can see which spots are open for each day. Contact us at <a
        href="mailto:relations@teknikfokus.se"
        class="underline"
      >
        relations@teknikfokus.se</a
      >
      about securing a spot.
      <br />
      A green dot means that the spot is available, a red that it is not. Note that
      food and drinks are not allowed in the rooms where spot 14-27 are located.
      <div class="text-center">
        <div class="font-bold text-lg">Day 1</div>
        <Availabilitymapday1 />
        <div class="mt-10 font-bold text-lg">Day 2</div>
        <Availabilitymapday2 />
      </div>
    </section>
  </div>
</Layout>
