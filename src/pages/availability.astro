---
import Availabilitymapday1 from "~/components/availabilitymapday1.astro";
import Availabilitymapday2 from "~/components/availabilitymapday2.astro";

import Layout from "~/layouts/Layout.astro";
---

<Layout>
  <div class="mx-auto max-w-prose px-8 pt-10">
    <section>
      <h2 class="text-balance font-extrabold text-6xl">Secure your spot!</h2>
      Here you can see which spots are open for each day. Contact us at <a
        href="mailto:relations@teknikfokus.se"
        class="underline"
      >
        relations@teknikfokus.se</a
      >
      about securing a spot.
      <br />
      A green dot means that the spot is available to reserve, a red that it is not.
      A golden dot means it is reserved for the luxury package. It is optional to
      reserve a spot, otherwise your company will be placed at an appropriate place.
      <div class="text-center">
        <div class="font-bold text-lg">Day 1</div>
        <Availabilitymapday1 />
        <div class="mt-10 font-bold text-lg">Day 2</div>
        <Availabilitymapday2 />
      </div>
    </section>
  </div>
</Layout>
