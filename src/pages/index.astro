---
import NewLandingLayout from "~/layouts/NewLandingLayout.astro";
import cover from "../assets/cover.webp";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import Logo from "~/components/deltaLogo.astro";
---

<NewLandingLayout>
  <section class="h-screen">
    <div
      class="h-screen lg:grid lg:grid-flow-col lg:place-content-center lg:gap-20"
    >
      <div class="mx-4 flex flex-col items-center py-12 short:py-8">
        <h1
          class="mb-4 w-min text-center font-extrabold text-4xl [line-height:1.5] short:[line-height:1.0]"
        >
          TEKNIK<span class="font-light">FOKUS</span>
        </h1>

        <p class="mt-2 text-center font-bold leading-snug text-2xl">
          Teknikfokus has transformed into <span
            class="underline decoration-2 underline-offset-4"
            >two separate fairs</span
          >.
        </p>

        <div class="mt-6 flex flex-col items-center gap-4 font-bold text-lg">
          <p>Delta for Computer and Communications engineers</p>
          <p>Impuls for Electrical and Biomedical engineers</p>
        </div>

        <div class="my-6 w-24 border-t border-default"></div>

        <p class="text-center font-light text-offset text-base">
          Visit their websites for more information
        </p>

        <Icon
          name="logomark"
          class="mt-8 size-36 lg:hidden short:mt-4 short:size-20"
        />

        <div class="mt-8 flex flex-col gap-4 md:flex-row short:mt-4">
          <a
            href="https://delta.dsek.se"
            class="rounded-full border-4 border-white bg-[#f280a1] px-8 py-4 font-bold text-white text-lg hover:bg-[#ff89aa] short:py-2"
          >
            <!-- <h1 aria-label="DELTA" role="img" class="contents">
              <Logo class="text-7xl lg:text-9xl" animate />
            </h1> -->
            DELTA
          </a>
          <a
            href="https://impuls.esek.se"
            class="rounded-full border-4 border-white bg-[#181818] px-8 py-4 font-bold text-white text-lg hover:bg-[#2c2c2c] short:py-2"
          >
            IMPULS
          </a>
        </div>
      </div>

      <Icon name="full-logo" class="hidden size-4/5 min-w-48 lg:block" />
    </div>

    <!-- Background -->
    <Image
      src={cover}
      alt="Background image of the fair"
      class="absolute inset-0 -z-10 h-full w-full object-cover opacity-20"
    />
    <div
      class="hero-background absolute inset-0 -z-10 h-full w-full bg-teknikfokus-950/10 opacity-40"
    >
    </div>
    <!-- Background -->
  </section>
</NewLandingLayout>

<style>
  .hero-background {
    background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23489ab8' fill-opacity='0.14'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
  }
</style>
