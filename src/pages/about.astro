    class="max-h-[60vh] w-full object-cover"
    src={group}
    alt="Project Group"
  />
  <div class="mx-auto my-8 max-w-prose py-8">
    <section>
      <h2 class="mb-8 text-balance text-center font-extrabold text-6xl">
        Project Group
      </h2>
      <div class="grid grid-cols-1 gap-20 md:grid-cols-2">
        {
          projectGroup.map((person) => (
            <Person
              name={person.name}
              position={person.position}
              image={person.image}
              linkedin={person.linkedin}
              email={person.email}
            />
          ))
        }
      </div>
    </section>
  </div>
</Layout>
